--- !u!114 &270109394
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132149424371612}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fde9e6c05e247ec4ea9eba8397b000e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  subject: Shell Ornament
  context: 'The shell ornament of Huluga Cave is an important archaeological artifact
    discovered at the Huluga archaeological site in Cagayan de Oro, Philippines.
    It was made from a shell and used as an armlet worn around the arm. Similar ornaments
    were found alongside human remains and other burial objects. These discoveries
    suggest that shell ornaments may have played a role in ancient burial practices.


    The
    artifact also shows how early inhabitants used natural materials to create personal
    decorations. Its craftsmanship provides clues about the skills and traditions
    of ancient Filipino communities. Today, the shell ornament helps researchers
    understand the cultural practices and history of prehistoric people in the Philippines.'
  logbookBook: {fileID: 876973139}
