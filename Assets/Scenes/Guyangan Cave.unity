--- !u!114 &692183380
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 692183379}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fde9e6c05e247ec4ea9eba8397b000e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  subject: Wooden Coffin
  context: 'The wooden coffins of Guyangan Cave are important archaeological artifacts
    discovered in the Guyangan Cave System on Banton Island, Romblon, Philippines.
    These coffins were carved from hardwood and used in ancient Filipino burial practices.
    Some coffins feature serpent-like designs on their lids, showing the artistic
    skills of early Filipino communities.


    The coffins were crafted from tree
    trunks, with hollowed-out sections used to hold the deceased. These artifacts
    provide valuable evidence of the burial customs and cultural beliefs of precolonial
    Filipinos. Today, they help archaeologists understand the history and traditions
    of ancient communities in the Philippines.'
  logbookBook: {fileID: 425985354}
