--- !u!114 &3469287837829660556
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132147775974040}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fde9e6c05e247ec4ea9eba8397b000e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  subject: Manggul Jar
  context: "The Manunggul Jar is an ancient burial jar discovered in the Tabon Caves
    of Palawan, Philippines. It dates back to around 890\u2013710 BC and is considered
    one of the most important artifacts of Philippine prehistory. The jar was used
    for secondary burial, a practice in which the bones of the deceased were placed
    inside after the body had decomposed.\n\nThe jar\u2019s lid features two human
    figures riding a boat, symbolizing the journey of the soul to the afterlife.
    It reflects the beliefs of early Filipinos about death and life after death.
    Its intricate decorations showcase the artistic skills of ancient Filipino communities.
    Today, the Manunggul Jar is recognized as a National Cultural Treasure of the
    Philippines."
  logbookBook: {fileID: 1049444014}
